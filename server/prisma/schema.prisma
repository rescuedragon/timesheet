generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String       @id @default(cuid())
  name        String
  totalTime   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  subprojects Subproject[]
  timeLogs    TimeLog[]

  @@map("projects")
}

model Subproject {
  id        String    @id @default(cuid())
  name      String
  totalTime Int       @default(0)
  projectId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeLogs  TimeLog[]

  @@map("subprojects")
}

model TimeLog {
  id              String     @id @default(cuid())
  projectId       String
  subprojectId    String
  projectName     String
  subprojectName  String
  duration        Int
  description     String?
  date            String
  startTime       String
  endTime         String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subproject      Subproject @relation(fields: [subprojectId], references: [id], onDelete: Cascade)

  @@map("time_logs")
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("holidays")
}